<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: excluye la sesión cifrada (DataStore) del respaldo en la nube y de la transferencia entre dispositivos. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
